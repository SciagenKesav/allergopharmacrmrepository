    <errorConditionFormula>AND(ISPICKVAL(Transaction_Type__c,&apos;Return&apos;), ISPICKVAL(Return_Reason__c,&apos;&apos;))</errorConditionFormula>
    <errorDisplayField>Return_Reason__c</errorDisplayField>
