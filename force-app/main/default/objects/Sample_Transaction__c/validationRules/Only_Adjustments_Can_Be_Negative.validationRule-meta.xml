<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Only_Adjustments_Can_Be_Negative</fullName>
    <active>true</active>
    <errorConditionFormula>AND(NOT(ISPICKVAL(Transaction_Type__c,&apos;Adjustment&apos;)), Quantity__c &lt;= 0)</errorConditionFormula>
    <errorDisplayField>Quantity__c</errorDisplayField>
    <errorMessage>Quantity must be more than zero.</errorMessage>
</ValidationRule>
