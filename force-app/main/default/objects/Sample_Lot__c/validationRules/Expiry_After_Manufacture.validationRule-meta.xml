<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Expiry_After_Manufacture</fullName>
    <active>true</active>
    <errorConditionFormula>AND(NOT(ISBLANK(Manufactured_Date__c)), Expiry_Date__c &lt;= Manufactured_Date__c)</errorConditionFormula>
    <errorDisplayField>Expiry_Date__c</errorDisplayField>
    <errorMessage>Expiry date must be after the manufactured date.</errorMessage>
</ValidationRule>
