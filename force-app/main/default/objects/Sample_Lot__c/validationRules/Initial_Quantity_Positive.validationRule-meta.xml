<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Initial_Quantity_Positive</fullName>
    <active>true</active>
    <!-- D11 (Phase 0 hotfix): Initial_Quantity__c is now optional (deprecated, off the
         layout, read-only in FLS) -- blank must be allowed, since it's no longer captured
         at all for a lot created any way other than Apex's Transfer-In landing path. Still
         rejects an explicit zero-or-negative value, the rule's original purpose. -->
    <errorConditionFormula>NOT(ISBLANK(Initial_Quantity__c)) &amp;&amp; Initial_Quantity__c &lt;= 0</errorConditionFormula>
    <errorDisplayField>Initial_Quantity__c</errorDisplayField>
    <errorMessage>Initial quantity must be more than zero.</errorMessage>
</ValidationRule>
