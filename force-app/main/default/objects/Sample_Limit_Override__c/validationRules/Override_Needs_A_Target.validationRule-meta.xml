<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Override_Needs_A_Target</fullName>
    <active>true</active>
    <errorConditionFormula>AND(ISBLANK(Target_Account__c), ISBLANK(Target_User__c))</errorConditionFormula>
    <errorDisplayField>Target_Account__c</errorDisplayField>
    <errorMessage>Choose the doctor or the rep the override is for.</errorMessage>
</ValidationRule>
