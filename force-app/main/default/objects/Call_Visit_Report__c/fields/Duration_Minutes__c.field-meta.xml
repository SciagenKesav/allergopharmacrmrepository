<?xml version="1.0" encoding="UTF-8"?>
<CustomField xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Duration_Minutes__c</fullName>
    <description>Call duration in minutes, calculated as End_Time__c minus Start_Time__c. 0 if either time isn't set (a Number formula field can't return a true blank).</description>
    <externalId>false</externalId>
    <formula>IF(
    OR(ISBLANK(Start_Time__c), ISBLANK(End_Time__c)),
    0,
    (End_Time__c - Start_Time__c) * 24 * 60
)</formula>
    <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
    <label>Duration (Minutes)</label>
    <precision>18</precision>
    <required>false</required>
    <scale>0</scale>
    <trackTrending>false</trackTrending>
    <type>Number</type>
    <unique>false</unique>
</CustomField>
